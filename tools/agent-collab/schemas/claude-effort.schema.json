{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-collab/claude-effort.schema.json",
  "title": "Agent Collab Claude Actual-Run Effort Evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "expected_effort", "observations"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "run_id": {"type": "string", "minLength": 1},
    "expected_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "observations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effort", "error"],
        "properties": {
          "effort": {"enum": [null, "low", "medium", "high", "xhigh", "max"]},
          "error": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 512}]}
        },
        "not": {"properties": {"effort": {"const": null}, "error": {"const": null}}, "required": ["effort", "error"]}
      }
    }
  }
}
