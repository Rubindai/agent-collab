{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-collab/settings.schema.json",
  "title": "Agent Collab Settings v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "settings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "updated_at": {"type": "string", "minLength": 1},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_subagents_allowed",
        "max_local_subagents",
        "adjudicator_enabled",
        "agent_timeout_seconds",
        "safe_mode",
        "codex_model",
        "codex_effort",
        "online_research",
        "codex_config",
        "claude_model",
        "claude_effort",
        "claude_tools",
        "history_retained_runs"
      ],
      "properties": {
        "local_subagents_allowed": {"type": "boolean"},
        "max_local_subagents": {"type": "integer", "minimum": 0, "maximum": 64},
        "adjudicator_enabled": {"type": "boolean"},
        "agent_timeout_seconds": {"type": "number", "minimum": 60, "maximum": 86400},
        "safe_mode": {"type": "boolean"},
        "codex_model": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "codex_effort": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "online_research": {"type": "boolean"},
        "codex_config": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!(?:agents|features|approval_policy|model|model_reasoning_effort|sandbox_mode|web_search)(?:\\.|=))[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*="
          }
        },
        "claude_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "pattern": "^\\s*(?:[Ff][Aa][Bb][Ll][Ee]|[Cc][Ll][Aa][Uu][Dd][Ee]-[Ff][Aa][Bb][Ll][Ee]-.*)\\s*$"
          }
        },
        "claude_effort": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "claude_tools": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "anyOf": [
            {"const": "default"},
            {"not": {"pattern": "(?:^|[\\s,])[Dd][Ee][Ff][Aa][Uu][Ll][Tt](?:$|[\\s,])"}}
          ]
        },
        "history_retained_runs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
