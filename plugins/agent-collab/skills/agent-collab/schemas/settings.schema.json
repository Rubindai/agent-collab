{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agent-collab/settings.schema.json",
  "title": "Agent Collab Settings v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "settings"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "updated_at": {"type": "string", "minLength": 1},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_subagents_allowed",
        "max_local_subagents",
        "adjudicator_enabled",
        "agent_timeout_seconds",
        "safe_mode",
        "workspace_mode",
        "codex_model",
        "codex_effort",
        "online_research",
        "codex_config",
        "claude_model",
        "claude_effort",
        "claude_tools",
        "history_retained_runs"
      ],
      "properties": {
        "local_subagents_allowed": {"type": "boolean"},
        "max_local_subagents": {"type": "integer", "minimum": 0, "maximum": 64},
        "adjudicator_enabled": {"type": "boolean"},
        "agent_timeout_seconds": {"type": "number", "minimum": 60, "maximum": 86400},
        "safe_mode": {"type": "boolean"},
        "workspace_mode": {"enum": ["isolated", "direct"]},
        "codex_model": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "codex_effort": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "online_research": {"type": "boolean"},
        "codex_config": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!(?:agents|approval_policy|approvals_reviewer|apps_mcp_product_sku|auto_review|chatgpt_base_url|cli_auth_credentials_store|daybreak|default_permissions|experimental_realtime_webrtc_call_base_url|experimental_realtime_ws_base_url|experimental_realtime_ws_model|features|forced_chatgpt_workspace_id|forced_login_method|memories|model|model_catalog_json|model_provider|model_providers|model_reasoning_effort|openai_base_url|oss_provider|permissions|plan_mode_reasoning_effort|profile|profiles|responses_api_metadata|review_model|sandbox_mode|sandbox_workspace_write|service_tier|tools|web_search)(?:\\.|=))[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*="
          }
        },
        "claude_model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "pattern": "(?:^|[^A-Za-z0-9])[Ff][Aa][Bb][Ll][Ee](?:$|[^A-Za-z0-9])"
          }
        },
        "claude_effort": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "claude_tools": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "anyOf": [
            {"const": "default"},
            {"not": {"pattern": "(?:^|[\\s,])[Dd][Ee][Ff][Aa][Uu][Ll][Tt](?:$|[\\s,])"}}
          ]
        },
        "history_retained_runs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
